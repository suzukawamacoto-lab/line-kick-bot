const express = require('express');
const { Client, Middleware } = require('@line/bot-sdk');
const app = express();

// 環境変数から設定を読み込み
const config = {
  channelAccessToken: process.env.CHANNEL_ACCESS_TOKEN,
  channelSecret: process.env.CHANNEL_SECRET,
};

const client = new Client(config);
const middleware = Middleware(config);

// 保護中のユーザーを保存
const protectUsers = new Set();

// ヘルスチェック
app.get('/health', (req, res) => {
  res.send('OK');
});

// Webhook
app.post('/webhook', middleware, async (req, res) => {
  res.sendStatus(200);
  const events = req.body.events;

  for (const event of events) {
    // メッセージコマンド処理
    if (event.type === 'message' && event.message.type === 'text') {
      const text = event.message.text;
      const userId = event.source.userId;

      if (text === '/kick protect') {
        protectUsers.add(userId);
        await client.replyMessage(event.replyToken, {
          type: 'text',
          text: '✅ このユーザーを蹴り保護しました！'
        });
      } else if (text === '/kick unprotect') {
        protectUsers.delete(userId);
        await client.replyMessage(event.replyToken, {
          type: 'text',
          text: '❌ 蹴り保護を解除しました！'
        });
      } else if (text === '/kick list') {
        await client.replyMessage(event.replyToken, {
          type: 'text',
          text: `🛡️ 保護中のユーザー: ${protectUsers.size}人`
        });
      }
    }

    // 誰かが蹴られた/退出した時の検知
    if (event.type === 'memberLeft') {
      const leftMembers = event.left.members;
      const groupId = event.source.groupId;

      for (const member of leftMembers) {
        if (protectUsers.has(member.userId)) {
          // 保護中のユーザーが蹴られた → 警告通知
          await client.pushMessage(groupId, {
            type: 'text',
            text: `⚠️ 【警告】保護中のユーザーが退出させられました！\nUserID: ${member.userId}`
          });
        }
      }
    }
  }
});

// ✅ ここが最重要！Renderのポート設定
const PORT = process.env.PORT || 3000;
app.listen(PORT, () => {
  console.log(`Server running on port ${PORT}`);
});
